# =============================================================================
#  CyrusAsha_OllamaProxy — configuration (dotenv style)
#  Code. Intelligence. Order.
# =============================================================================
#
#  This file and CyrusAsha_OllamaProxy.config.json are two faces of ONE config.
#  On every run both files are read, merged, and the newest change of each key
#  is written back to both of them:
#
#      .env (this file)  <──>  CyrusAsha_OllamaProxy.config.json
#
#  Edit whichever file you like. Keep the same keys in both and they stay
#  identical; comments in this file are preserved by the sync.
#
#  Shell variables always win over both files, for example:
#      CONFIG_SYNC=off npm start        # read config, never write back
#
# -----------------------------------------------------------------------------
# Local server
# -----------------------------------------------------------------------------
# Ollama-compatible port. Visual Studio / GitHub Copilot expects 11434.
PORT=11434
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Upstreams — mode 1: one freellmapi address and one API key (classic mode)
# -----------------------------------------------------------------------------
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=freellmapi-REPLACE_ME

# -----------------------------------------------------------------------------
# Upstreams — mode 2: several addresses / keys as CSV, paired by index
# -----------------------------------------------------------------------------
#  baseURL[0] -> apiKey[0], baseURL[1] -> apiKey[1], ...
#  One URL  + many keys -> that URL is used with every key.
#  Many URLs + one key  -> that key is used for every URL.
#
# FREELLMAPI_BASE_URLS=http://127.0.0.1:3001/v1,http://127.0.0.1:3002/v1
# FREELLMAPI_API_KEYS=freellmapi-KEY-1,freellmapi-KEY-2

# -----------------------------------------------------------------------------
# Upstreams — mode 3: full JSON with names (this mode wins over the others)
# -----------------------------------------------------------------------------
#  In .env keep it on a single line. In CyrusAsha_OllamaProxy.config.json the
#  very same value is a real JSON array, which is easier to read and edit.
#
# FREELLMAPI_UPSTREAMS_JSON=[{"name":"local-1","baseURL":"http://127.0.0.1:3001/v1","apiKey":"freellmapi-KEY-1"}]

# -----------------------------------------------------------------------------
# Upstream selection
# -----------------------------------------------------------------------------
# ordered     = always start with the first upstream, fail over on retryable errors.
# round-robin = rotate the starting upstream per request, still fail over.
UPSTREAM_STRATEGY=ordered

# Status codes that trigger failover to the next upstream.
RETRY_STATUS_CODES=401,403,404,408,409,429,500,502,503,504

# -----------------------------------------------------------------------------
# Model aliasing
# -----------------------------------------------------------------------------
# DEFAULT_MODEL is the fallback model sent upstream to freellmapi.
DEFAULT_MODEL=auto

# Format: visible-name=upstream-model
# Copilot sees "visible-name:latest" while freellmapi receives "upstream-model".
OLLAMA_MODELS=copilot-free=auto
ADD_LATEST_TAG=true

# More examples:
# OLLAMA_MODELS=copilot-free=auto,my-fusion=fusion
# OLLAMA_MODELS=llama3.1:8b=auto

# Timeout for upstream requests, in milliseconds.
REQUEST_TIMEOUT_MS=120000
